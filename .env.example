# ── News API keys (server-side only — never committed or sent to the browser) ──

# The Guardian Open Platform — free, register at:
#   https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=your-guardian-api-key-here

# GNews — free tier (100 req/day), register at:
#   https://gnews.io/
# Optional: app works without it; only Guardian articles are shown per cluster.
GNEWS_API_KEY=your-gnews-api-key-here

# Express server port (default: 3001)
# PORT=3001
